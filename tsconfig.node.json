{
  // Dev tooling: the CI runner (Bun) and Drive Cleanup's unit tests (node:test API).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["dev/*.ts", "dev/types/claude-code", "plugins/drive-cleanup/dev"]
}
